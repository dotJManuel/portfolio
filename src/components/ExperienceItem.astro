---
import type { Experiencia } from '../data/types';
interface Props { 
  experiencia: Experiencia; 
}
const { experiencia } = Astro.props;
const { puesto, empresa, periodo, ubicacion, logros } = experiencia;
---

<div class="exp">
  <div class="exp-meta">
    <div class="exp-period">{periodo}</div>
    <div class="exp-company">{empresa}</div>
    <div class="exp-role">{puesto}</div>
    <div class="exp-location">{ubicacion}</div>
  </div>
  <div class="exp-logros">
    {logros.map((l) => (
      <div class="logro">
        <div class="logro-dash"></div>
        <p class="logro-text">{l}</p>
      </div>
    ))}
  </div>
</div>

<style>
  .exp {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: calc(var(--space-8) * 1.2);
    align-items: start;
  }
  .exp-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 280px;
  }
  .exp-period {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--color-accent-300);
  }
  .exp-company { font-size: 19px; letter-spacing: -0.018em; }
  .exp-role { font-size: 13.5px; color: var(--color-neutral-400); }
  .exp-location { font-size: 12.5px; color: var(--color-neutral-600); line-height: 1.5; }
  .exp-logros {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    border-left: 1px solid var(--color-neutral-800);
    padding-left: calc(var(--space-8) * 1.1);
    grid-column: span 2;
    min-width: 0;
  }
  .logro {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
  }
  .logro-dash { height: 1px; background: var(--color-accent-600); margin-top: 12px; }
  .logro-text {
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-neutral-200);
    margin: 0;
    text-wrap: pretty;
  }
</style>