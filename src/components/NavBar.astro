---
import Loc from './Loc.astro';

const enlaces = [
  { en: "Home", es: "Inicio", href: "#inicio", id: "inicio" },
  { en: "Technologies", es: "Tecnologías", href: "#tecnologias", id: "tecnologias" },
  { en: "Experience", es: "Experiencia", href: "#experiencia", id: "experiencia" },
  { en: "Projects", es: "Proyectos", href: "#proyectos", id: "proyectos" },
  { en: "Certifications", es: "Certificaciones", href: "#certificaciones", id: "certificaciones" },
  { en: "Contact", es: "Contacto", href: "#contacto", id: "contacto" },
];
---

<header class="nav">
  <div class="nav-inner">
    <a href="#inicio" class="brand">
      <span class="brand-dot"></span>
      <span class="brand-name">JMH</span>
    </a>
    <nav class="nav-links">
      {enlaces.map((e) => (
        <a href={e.href} class="navlink" data-section={e.id}><Loc en={e.en} es={e.es} /></a>
      ))}
      <button type="button" class="langtoggle" aria-label="Toggle language">
        <span data-lang="en">ES</span><span data-lang="es">EN</span>
      </button>
      <button type="button" class="themetoggle" aria-label="Toggle theme">
        <svg class="t-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg class="t-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    backdrop-filter: blur(14px);
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    border-bottom: 1px solid var(--color-neutral-800);
  }
  .nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-4) calc(var(--space-8) * 1.6);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6);
    box-sizing: border-box;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--color-text);
    margin-right: auto;
  }
  .brand-dot {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--color-accent);
    box-shadow: 0 0 12px var(--color-accent);
  }
  .brand-name {
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.22em;
    font-weight: 500;
  }
  .nav-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1);
  }
  .navlink {
    text-decoration: none;
    font-size: 13px;
    letter-spacing: 0.01em;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    color: var(--color-neutral-400);
    transition: color 140ms ease, background 140ms ease;
  }
  .navlink.active { color: var(--color-accent-200); }
  .navlink:hover { background: var(--color-accent-900); color: var(--color-accent-200); }
  .langtoggle, .themetoggle {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    margin-left: var(--space-3);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-neutral-800);
    background: transparent;
    color: var(--color-neutral-400);
    cursor: pointer;
    transition: color 140ms ease, background 140ms ease, border-color 140ms ease;
  }
  .langtoggle:hover, .themetoggle:hover { background: var(--color-accent-900); color: var(--color-accent-200); border-color: var(--color-accent-700); }
  .themetoggle { margin-left: var(--space-1); display: inline-flex; align-items: center; justify-content: center; }
</style>

<script>
  const SECCIONES = ["inicio", "tecnologias", "experiencia", "proyectos", "certificaciones", "contacto"];
  const links: Record<string, HTMLElement> = {};
  const visibles: Record<string, boolean> = {};

  document.querySelectorAll<HTMLElement>(".navlink").forEach((a) => {
    links[a.dataset.section!] = a;
  });
  
  function setActive(id: string) {
    SECCIONES.forEach((s) => {
      if (links[s]) links[s].classList.toggle("active", s === id);
    });
  }

  const io = new IntersectionObserver((entries) => {
    entries.forEach((en) => { 
      visibles[en.target.id] = en.isIntersecting; 
    });

    const dentro = SECCIONES.filter((id) => visibles[id]);
    
    if (dentro.length) {
      setActive(dentro[0]);
    } else {
      let mejor = SECCIONES[0];
      SECCIONES.forEach((id) => {
        const el = document.getElementById(id);
        if (el && el.getBoundingClientRect().top <= 120) mejor = id;
      });
      setActive(mejor);
    }
  }, { 
    rootMargin: "-45% 0px -50% 0px", threshold: 0 
  });

  SECCIONES.forEach((id) => {
    const el = document.getElementById(id);
    if (el) io.observe(el);
  });

  setActive("inicio");

  const toggle = document.querySelector<HTMLButtonElement>(".langtoggle");
  toggle?.addEventListener("click", () => {
    const enActivo = document.documentElement.dataset.locale === "en";
    if (enActivo) {
      delete document.documentElement.dataset.locale;
      document.documentElement.lang = "es";
      localStorage.setItem("locale", "es");
    } else {
      document.documentElement.dataset.locale = "en";
      document.documentElement.lang = "en";
      localStorage.setItem("locale", "en");
    }
  });

  const themeToggle = document.querySelector<HTMLButtonElement>(".themetoggle");
  themeToggle?.addEventListener("click", () => {
    const claroActivo = document.documentElement.dataset.theme === "light";
    if (claroActivo) {
      delete document.documentElement.dataset.theme;
      localStorage.setItem("theme", "dark");
    } else {
      document.documentElement.dataset.theme = "light";
      localStorage.setItem("theme", "light");
    }
  });

</script>