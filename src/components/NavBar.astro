---
const enlaces = [
  { texto: "Inicio", href: "#inicio", id: "inicio" },
  { texto: "Tecnologías", href: "#tecnologias", id: "tecnologias" },
  { texto: "Experiencia", href: "#experiencia", id: "experiencia" },
  { texto: "Proyectos", href: "#proyectos", id: "proyectos" },
  { texto: "Certificaciones", href: "#certificaciones", id: "certificaciones" },
  { texto: "Contacto", href: "#contacto", id: "contacto" },
];
---

<header class="nav">
  <div class="nav-inner">
    <a href="#inicio" class="brand">
      <span class="brand-dot"></span>
      <span class="brand-name">JMH</span>
    </a>
    <nav class="nav-links">
      {enlaces.map((e) => (
        <a href={e.href} class="navlink" data-section={e.id}>{e.texto}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    backdrop-filter: blur(14px);
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    border-bottom: 1px solid var(--color-neutral-800);
  }
  .nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-4) calc(var(--space-8) * 1.6);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6);
    box-sizing: border-box;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--color-text);
    margin-right: auto;
  }
  .brand-dot {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--color-accent);
    box-shadow: 0 0 12px var(--color-accent);
  }
  .brand-name {
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.22em;
    font-weight: 500;
  }
  .nav-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1);
  }
  .navlink {
    text-decoration: none;
    font-size: 13px;
    letter-spacing: 0.01em;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    color: var(--color-neutral-400);
    transition: color 140ms ease, background 140ms ease;
  }
  .navlink.active { color: var(--color-accent-200); }
  .navlink:hover { background: var(--color-accent-900); color: var(--color-accent-200); }
</style>

<script>
  const SECCIONES = ["inicio", "tecnologias", "experiencia", "proyectos", "certificaciones", "contacto"];
  const links: Record<string, HTMLElement> = {};
  const visibles: Record<string, boolean> = {};

  document.querySelectorAll<HTMLElement>(".navlink").forEach((a) => {
    links[a.dataset.section!] = a;
  });
  
  function setActive(id: string) {
    SECCIONES.forEach((s) => {
      if (links[s]) links[s].classList.toggle("active", s === id);
    });
  }

  const io = new IntersectionObserver((entries) => {
    entries.forEach((en) => { 
      visibles[en.target.id] = en.isIntersecting; 
    });

    const dentro = SECCIONES.filter((id) => visibles[id]);
    
    if (dentro.length) {
      setActive(dentro[0]);
    } else {
      let mejor = SECCIONES[0];
      SECCIONES.forEach((id) => {
        const el = document.getElementById(id);
        if (el && el.getBoundingClientRect().top <= 120) mejor = id;
      });
      setActive(mejor);
    }
  }, { 
    rootMargin: "-45% 0px -50% 0px", threshold: 0 
  });

  SECCIONES.forEach((id) => {
    const el = document.getElementById(id);
    if (el) io.observe(el);
  });

  setActive("inicio");

</script>