---
import type { Localized, ProyectoImagen, ProyectoDiagrama } from '../data/types';
import Loc from './Loc.astro';
interface Props {
  titulo: Localized;
  descripcion: Localized;
  tecnologias: string[];
  destacados?: Localized[];
  imagenes?: ProyectoImagen[];
  diagramas?: ProyectoDiagrama[];
  rol?: Localized;
  demo?: string;
  index: number;
}
const { titulo, descripcion, tecnologias, destacados, imagenes, diagramas, rol, demo, index } = Astro.props as Props;
const num = String(index + 1).padStart(2, "0");
const abierto = index === 0;
---

<div class:list={["proj-item", { open: abierto }]}>
  <div class="proj-row" role="button" tabindex="0">
    <div class="proj-num">{num}</div>
    <div class="proj-main">
      <div class="proj-title"><Loc en={titulo.en} es={titulo.es} /></div>
      <div class="proj-tags">
        {tecnologias.map((t) => <span class="proj-tag">{t}</span>)}
      </div>
    </div>
    <div class="proj-sign">{abierto ? "–" : "+"}</div>
  </div>
  <div class="proj-detail" hidden={!abierto}>
    <div class="proj-line"></div>
    <div class="proj-body">
      <p class="proj-desc"><Loc en={descripcion.en} es={descripcion.es} /></p>
      {destacados && destacados.length > 0 && (
        <ul class="proj-highlights">
          {destacados.map((d) => (
            <li class="proj-highlight"><Loc en={d.en} es={d.es} /></li>
          ))}
        </ul>
      )}
      {imagenes && imagenes.length > 0 && (
        <div class="proj-shots">
          {imagenes.map((img) => (
            <figure class="shot">
              <img
                class="zoomable"
                src={img.src}
                alt={img.caption.en}
                loading="lazy"
                onerror="this.parentElement.classList.add('is-missing')"
              />
              <div class="shot-ph"><span class="shot-ph-file">{img.src}</span></div>
              <figcaption class="shot-cap"><Loc en={img.caption.en} es={img.caption.es} /></figcaption>
            </figure>
          ))}
        </div>
      )}
      {diagramas && diagramas.length > 0 && (
        <div class="proj-diagrams">
          {diagramas.map((d) => (
            <figure class="proj-diagram">
              <div class="diagram-frame">
                <img class="diagram-img zoomable" data-lang="en" src={d.srcEn} alt={d.caption.en} loading="lazy" />
                <img class="diagram-img zoomable" data-lang="es" src={d.srcEs} alt={d.caption.es} loading="lazy" />
              </div>
              <figcaption class="shot-cap"><Loc en={d.caption.en} es={d.caption.es} /></figcaption>
            </figure>
          ))}
        </div>
      )}
      {rol && <div class="proj-role"><Loc en="ROLE" es="ROL" /> — <Loc en={rol.en} es={rol.es} /></div>}
      {demo && <a href={demo} target="_blank" rel="noopener" class="proj-link"><Loc en="View product ↗" es="Ver producto ↗" /></a>}
    </div>
  </div>
</div>

<style>
  .proj-item { border-bottom: 1px solid var(--color-neutral-800); }
  .proj-row {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) 24px;
    gap: var(--space-4);
    align-items: start;
    padding: var(--space-8) var(--space-3);
    cursor: pointer;
    transition: background 140ms ease;
  }
  .proj-row:hover { background: var(--color-neutral-900); }
  .proj-num {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-neutral-600);
    padding-top: 6px;
  }
  .proj-main { display: flex; flex-direction: column; gap: var(--space-3); min-width: 0; }
  .proj-title {
    font-size: 19px;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--color-neutral-300);
    text-wrap: pretty;
  }
  .proj-item.open .proj-title { color: var(--color-neutral-100); }
  .proj-tags { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .proj-tag {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    color: var(--color-neutral-400);
    border: 1px solid var(--color-neutral-800);
    border-radius: var(--radius-sm);
    padding: 3px 7px;
  }
  .proj-sign {
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--color-accent-400);
    text-align: right;
    padding-top: 3px;
  }
  .proj-detail {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: var(--space-4);
    padding: 0 var(--space-3) var(--space-8);
  }
  .proj-detail[hidden] { display: none !important; }
  .proj-line { border-left: 1px solid var(--color-accent-700); margin-left: 5px; }
  .proj-body { display: flex; flex-direction: column; gap: var(--space-4); }
  .proj-desc {
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-neutral-300);
    margin: 0;
    max-width: 90ch;
    text-wrap: pretty;
  }
  .proj-highlights {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    max-width: 90ch;
    list-style: none;
  }
  .proj-highlight {
    position: relative;
    padding-left: var(--space-6);
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-neutral-300);
    text-wrap: pretty;
  }
  .proj-highlight::before {
    content: "";
    position: absolute;
    left: 0;
    top: 10px;
    width: 10px;
    height: 1px;
    background: var(--color-accent-500);
  }
  .proj-shots {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-2);
  }
  .shot { margin: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .shot img {
    width: 100%;
    display: block;
    border: 1px solid var(--color-neutral-800);
    border-radius: var(--radius-sm);
  }
  .zoomable { cursor: zoom-in; }
  .shot-ph { display: none; }
  .shot.is-missing img { display: none; }
  .shot.is-missing .shot-ph {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 10;
    border: 1px dashed var(--color-neutral-700);
    border-radius: var(--radius-sm);
    background: var(--color-neutral-900);
    padding: var(--space-4);
  }
  .shot-ph-file {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--color-neutral-500);
    text-align: center;
    overflow-wrap: anywhere;
  }
  .shot-cap {
    font-size: 12px;
    line-height: 1.5;
    color: var(--color-neutral-500);
    text-wrap: pretty;
  }
  .proj-diagrams {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    gap: var(--space-6);
    margin-top: var(--space-2);
  }
  @media (max-width: 560px) {
    .proj-diagrams { grid-template-columns: 1fr; }
  }
  .proj-diagram { margin: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .diagram-frame {
    flex: 1;
    display: grid;
    place-items: center;
    line-height: 0;
    border: 1px solid var(--color-neutral-800);
    border-radius: var(--radius-sm);
    background: var(--color-neutral-900);
    padding: var(--space-6);
    overflow: hidden;
  }
  .diagram-img { max-height: 300px; width: auto; max-width: 100%; height: auto; }
  .proj-role {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--color-neutral-500);
  }
  .proj-link { font-size: 13.5px; width: fit-content; }
</style>