---
interface Props {
    titulo: string;
    descripcion: string;
    tecnologias: string[];
    rol?: string;
    repo?: string;
    demo?: string;
}

const { titulo, descripcion, tecnologias, rol, repo, demo } = Astro.props as Props;
---

<article class="card">
    <h3>{titulo}</h3>
    {rol && <p class="rol">{rol}</p>}
    <p>{descripcion}</p>

    <ul class="tags">
        {tecnologias.map((tech) => <li>{tech}</li>)}
    </ul>

    <div class="links">
        {demo && <a href={demo} class="link" target="_blank" rel="noopener">Ver producto</a>}
        {repo && <a href={repo} class="link">Ver código</a>}
    </div>
</article>

<style>
  .card {
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 1.5rem;
    background: white;
  }
  .card h3 { 
    margin: 0 0 0.5rem; 
  }
  .rol {
    margin: 0 0 0.75rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: #2563eb;
  }
  .card p { 
    color: #555; 
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 1rem 0;
  }
  .tags li {
    background: #eff6ff;
    color: #2563eb;
    font-size: 0.8rem;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
  }
  .links {
    display: flex;
    gap: 1rem;
  }
  .link { 
    color: #2563eb; 
    text-decoration: none; 
    font-weight: 600; 
  }
</style>