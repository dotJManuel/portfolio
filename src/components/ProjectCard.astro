---
interface Props {
    titulo: string;
    descripcion: string;
    tecnologias: string[];
    repo?: string;
}

const { titulo, descripcion, tecnologias, repo } = Astro.props as Props;
---

<article class="card">
    <h3>{titulo}</h3>
    <p>{descripcion}</p>

    <ul class="tags">
        {tecnologias.map((tech) => <li>{tech}</li>)}
    </ul>

    {repo && <a href={repo} class="link">Ver código</a>}
</article>

<style>
  .card {
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 1.5rem;
    background: white;
  }
  .card h3 { margin: 0 0 0.5rem; }
  .card p { color: #555; }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 1rem 0;
  }
  .tags li {
    background: #eff6ff;
    color: #2563eb;
    font-size: 0.8rem;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
  }
  .link { color: #2563eb; text-decoration: none; font-weight: 600; }
</style>