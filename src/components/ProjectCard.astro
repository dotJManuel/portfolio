---
interface Props {
  titulo: string;
  descripcion: string;
  tecnologias: string[];
  rol?: string;
  demo?: string;
  index: number;
}
const { titulo, descripcion, tecnologias, rol, demo, index } = Astro.props as Props;
const num = String(index + 1).padStart(2, "0");
const abierto = index === 0;
---

<div class:list={["proj-item", { open: abierto }]}>
  <div class="proj-row" role="button" tabindex="0">
    <div class="proj-num">{num}</div>
    <div class="proj-main">
      <div class="proj-title">{titulo}</div>
      <div class="proj-tags">
        {tecnologias.map((t) => <span class="proj-tag">{t}</span>)}
      </div>
    </div>
    <div class="proj-sign">{abierto ? "–" : "+"}</div>
  </div>
  <div class="proj-detail" hidden={!abierto}>
    <div class="proj-line"></div>
    <div class="proj-body">
      <p class="proj-desc">{descripcion}</p>
      {rol && <div class="proj-role">ROL — {rol}</div>}
      {demo && <a href={demo} target="_blank" rel="noopener" class="proj-link">Ver producto ↗</a>}
    </div>
  </div>
</div>

<style>
  .proj-item { border-bottom: 1px solid var(--color-neutral-800); }
  .proj-row {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) 24px;
    gap: var(--space-4);
    align-items: start;
    padding: var(--space-8) var(--space-3);
    cursor: pointer;
    transition: background 140ms ease;
  }
  .proj-row:hover { background: var(--color-neutral-900); }
  .proj-num {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-neutral-600);
    padding-top: 6px;
  }
  .proj-main { display: flex; flex-direction: column; gap: var(--space-3); min-width: 0; }
  .proj-title {
    font-size: 19px;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--color-neutral-300);
    text-wrap: pretty;
  }
  .proj-item.open .proj-title { color: var(--color-neutral-100); }
  .proj-tags { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .proj-tag {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    color: var(--color-neutral-400);
    border: 1px solid var(--color-neutral-800);
    border-radius: var(--radius-sm);
    padding: 3px 7px;
  }
  .proj-sign {
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--color-accent-400);
    text-align: right;
    padding-top: 3px;
  }
  .proj-detail {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: var(--space-4);
    padding: 0 var(--space-3) var(--space-8);
  }
  .proj-detail[hidden] { display: none !important; }
  .proj-line { border-left: 1px solid var(--color-accent-700); margin-left: 5px; }
  .proj-body { display: flex; flex-direction: column; gap: var(--space-4); max-width: 68ch; }
  .proj-desc {
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-neutral-300);
    margin: 0;
    text-wrap: pretty;
  }
  .proj-role {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--color-neutral-500);
  }
  .proj-link { font-size: 13.5px; width: fit-content; }
</style>