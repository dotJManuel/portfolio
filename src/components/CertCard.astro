---
import type { Certificacion } from '../data/types';
interface Props { cert: Certificacion; }
const { cert } = Astro.props;
const meta = `${cert.emisor} · ${cert.fecha}`;
---

<div class="cert">
  <div class="cert-info">
    <div class="cert-name">{cert.nombre}</div>
    <div class="cert-meta">{meta}</div>
  </div>
  {cert.url && (
    <a href={cert.url} target="_blank" rel="noopener" class="cert-verify">Verificar →</a>
  )}
</div>

<style>
  .cert {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-6);
    align-items: baseline;
    padding: var(--space-6) var(--space-3);
    border-bottom: 1px solid var(--color-neutral-800);
  }
  .cert-info { display: flex; flex-direction: column; gap: var(--space-1); min-width: 0; }
  .cert-name { font-size: 15.5px; color: var(--color-neutral-100); text-wrap: pretty; }
  .cert-meta { font-family: var(--font-mono); font-size: 11px; color: var(--color-neutral-400); }
  .cert-verify { font-size: 13px; white-space: nowrap; }
</style>