---
import type { CategoriaSkill } from '../data/types';

interface Props { 
  skill: CategoriaSkill; 
}
const { skill } = Astro.props;
---

<div class="skill">
  <div class="skill-cat">{skill.categoria}</div>
  <div class="skill-items">
    {skill.items.map((i) => <div class="skill-item">{i}</div>)}
  </div>
</div>

<style>
  .skill {
    background: var(--color-bg);
    padding: var(--space-8) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .skill-cat {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-neutral-500);
  }
  .skill-items { display: flex; flex-direction: column; gap: var(--space-2); }
  .skill-item { font-size: 14px; color: var(--color-neutral-200); }
</style>